{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "file-drop",
  "version": "0.1.0",
  "identifier": "com.bouka.file-drop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "file-drop",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEOEE5NDgxRjYxQ0REMEEKUldRSzNSejJnWlNLYlExZDdYZzJhZ2RtMDVXZENNcVdyMnAvZEVJWncydXc5Q0V3L1ptWDR6ekQK",
      "endpoints": [
        "https://github.com/boukaricoding-hash/file-drop/releases/latest/download/latest.json"
      ]
    }
  }
}